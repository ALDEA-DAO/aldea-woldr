# Cardano Network Configuration
# Options: Mainnet or Preprod
VITE_CARDANO_NETWORK=Preprod

# Blockfrost API Configuration
# Get your API key from https://blockfrost.io
# For Preprod:
VITE_BLOCKFROST_PROJECT_ID=preprodYourProjectIdHere
# For Mainnet:
# VITE_BLOCKFROST_PROJECT_ID=mainnetYourProjectIdHere

# Development Mode (Skip Cardano wallet verification for local testing)
# Set to 'true' to bypass wallet connection and asset verification
VITE_DEV_MODE=true

# Pyrope Chain Configuration (EVM-compatible)
# ALDEA Token Contract Address (ERC-20 on Pyrope)
# ⚠️ IMPORTANT: Replace with your deployed ALDEA token contract address on Pyrope
# Example: VITE_ALDEA_TOKEN_ADDRESS=0x1234567890abcdef1234567890abcdef12345678
VITE_ALDEA_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000

# Chain configuration is now hardcoded to Pyrope (695569)
# RPC: https://rpc.pyropechain.com
# No need to set VITE_CHAIN_ID or VITE_RPC_URL anymore
